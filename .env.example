# Claude API credentials for the agent (or run `ant auth login` on the host instead).
ANTHROPIC_API_KEY=

# Required in production. Protects every /api route: clients send `Authorization: Bearer <token>`.
HALEY_API_TOKEN=

# Required in production. 32 random bytes, hex or base64, used to encrypt client credentials at rest.
# Generate with: openssl rand -hex 32
HALEY_SECRET_KEY=

# Optional
PORT=8787
HALEY_DB_PATH=haley.db
HALEY_MODEL=claude-opus-5
# low | medium | high | xhigh | max
HALEY_EFFORT=high
# Server-side refusal fallbacks on the Claude API (set to off when routing through Bedrock/Vertex/Foundry or a proxy).
HALEY_FALLBACKS=on
HALEY_MAX_ITERATIONS=30
# Where the built dashboard lives; defaults to ../web/dist relative to the server.
# HALEY_WEB_DIST=
