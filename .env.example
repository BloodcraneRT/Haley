# Claude API credentials for the agent (or run `ant auth login` on the host instead).
ANTHROPIC_API_KEY=

# Required in production. Protects every /api route: clients send `Authorization: Bearer <token>`.
HALEY_API_TOKEN=

# Required in production. 32 random bytes, hex or base64, used to encrypt client credentials at rest.
# Generate with: openssl rand -hex 32
HALEY_SECRET_KEY=

# Optional
PORT=8787
HALEY_DB_PATH=haley.db
HALEY_MODEL=claude-opus-5
# low | medium | high | xhigh | max
HALEY_EFFORT=high
# Server-side refusal fallbacks on the Claude API (set to off when routing through Bedrock/Vertex/Foundry or a proxy).
HALEY_FALLBACKS=on
HALEY_MAX_ITERATIONS=30
# Where the built dashboard lives; defaults to ../web/dist relative to the server.
# HALEY_WEB_DIST=

# ---- Microsoft 365 onboarding (see docs/M365_ONBOARDING.md). Your MSP's multi-tenant Entra app;
# when set, clients connect with an admin-consent link. The redirect URI is $HALEY_PUBLIC_URL/hooks/m365/consent.
HALEY_M365_CLIENT_ID=
HALEY_M365_CLIENT_SECRET=

# ---- End-user channels (see docs/CHANNELS.md). Each is enabled when its secrets are set.
# Public URL of this server, used to show webhook addresses in the dashboard.
HALEY_PUBLIC_URL=
# Email: inbound webhook secret, and SMTP for replies.
HALEY_EMAIL_HOOK_SECRET=
HALEY_SMTP_URL=
HALEY_SMTP_FROM=
# Slack app signing secret (each client's bot token is added per client in the dashboard).
HALEY_SLACK_SIGNING_SECRET=
# Microsoft Teams (Azure Bot registration). Tenant only for single-tenant bots.
HALEY_TEAMS_APP_ID=
HALEY_TEAMS_APP_PASSWORD=
HALEY_TEAMS_TENANT_ID=
# Generic chat bridge HMAC secret (Google Chat, SMS, custom widgets).
HALEY_CHAT_WEBHOOK_SECRET=
